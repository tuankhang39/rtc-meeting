{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        "participants": {
          "$uid": {
            ".validate": "newData.hasChildren(['name', 'joinedAt', 'mic', 'camera'])"
          }
        }
      }
    },
    "roomIndex": {
      ".read": true,
      ".write": true
    }
  }
}
